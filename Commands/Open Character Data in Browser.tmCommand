	<string>#!/usr/bin/env ruby
# Opens the Unicode code chart that holds the character before the caret. The
# table maps code point ranges to the chart's PDF name on unicode.org.
exit 200 if ENV.key?("TM_SELECTED_TEXT")

line  = ENV.fetch("TM_CURRENT_LINE").dup.force_encoding("UTF-8")
index = ENV.fetch("TM_LINE_INDEX").to_i
left  = line.byteslice(0, index).force_encoding("UTF-8")
exit 200 if left.empty?

CHARTS = [
  [0x0000, 0x007F, "U0000.pdf"],
  [0x0080, 0x00FF, "U0080.pdf"],
  [0x0100, 0x017F, "U0100.pdf"],
  [0x0180, 0x024F, "U0180.pdf"],
