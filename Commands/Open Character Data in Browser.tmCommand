code = left[-1].ord
chart = CHARTS.find { |from, to, _| code.between?(from, to) }
exit 200 unless chart

system("open", "-a", "Safari", "http://www.unicode.org/charts/PDF/#{chart[2]}?%04X" % code)</string>
	<key>fallbackInput</key>
	<string>none</string>
	<key>input</key>
