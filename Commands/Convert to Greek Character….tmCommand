<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/usr/bin/env ruby
# Replaces the Latin letter before the caret with a Greek one. lib/greekList.txt
# has one row per Latin letter: the letter, then the Greek candidates. One
# candidate is inserted outright, several go through a menu with their Unicode
# names. Exit codes: 200 leaves the line alone, 201 replaces it, 206 shows a
# tool tip.
require "zlib"
require "#{ENV['TM_SUPPORT_PATH']}/lib/ui"

if ENV.key?("TM_SELECTED_TEXT")
  puts "Please remove the selection first."
  exit 206
end

line  = ENV.fetch("TM_CURRENT_LINE").dup.force_encoding("UTF-8")
index = ENV.fetch("TM_LINE_INDEX").to_i
left  = line.byteslice(0, index).force_encoding("UTF-8")
exit 200 if left.empty?

character = left[-1]
head      = left[0...-1]
tail      = line.byteslice(index..-1).force_encoding("UTF-8")

library = File.join(ENV.fetch("TM_BUNDLE_SUPPORT"), "lib")
rows = File.foreach(File.join(library, "greekList.txt"), encoding: "UTF-8").select { |row| row.start_with?(character) }
candidates = rows.map { |row| row.chomp[1..-1].chars }.flatten

if candidates.empty?
  print "Nothing found for '#{character}'."
  exit 206
end

if candidates.size == 1
  print head, candidates.first, tail
  exit 201
end

wanted = candidates.map { |c| "%04X" % c.ord }
names = {}
Zlib::GzipReader.open(File.join(library, "UnicodeData.txt.gz")) do |gz|
  gz.each_line do |row|
    code, name = row.split(";", 3)
    names[code] = name if wanted.include?(code)
  end
end

items = candidates.map { |c| "#{c}\t#{names.fetch("%04X" % c.ord, "U+%04X" % c.ord)}" }
chosen = TextMate::UI.menu(items)
exit 200 if chosen.nil?
print head, candidates[chosen], tail
exit 201</string>
	<key>fallbackInput</key>
	<string>line</string>
	<key>input</key>
	<string>selection</string>
	<key>keyEquivalent</key>
	<string>^~@u</string>
	<key>name</key>
	<string>Convert to Greek Character…</string>
	<key>output</key>
	<string>showAsTooltip</string>
	<key>uuid</key>
	<string>AC1FF4B5-2F93-4816-AA54-F4B150AFEFD2</string>
</dict>
</plist>
