<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>beforeRunningCommand</key>
	<string>nop</string>
	<key>command</key>
	<string>#!/usr/bin/env ruby
# Maps each Han character through lib/zhSimTradHanzi.txt, whose rows are the
# character, a flag, and its counterparts. A character with several
# counterparts becomes a snippet choice, and everything else passes through
# escaped for the snippet.
STDIN.set_encoding("UTF-8")

table = File.join(ENV.fetch("TM_BUNDLE_SUPPORT"), "lib", "zhSimTradHanzi.txt")
conversions = {}
File.foreach(table, encoding: "UTF-8") do |row|
  character, kind, counterparts = row.chomp.split("\t", 3)
  conversions[character] = counterparts if kind == "T"
end

if conversions.empty?
  puts "Error"
  exit 206
end

count = 1
STDIN.read.each_char do |character|
  counterparts = conversions[character]
  if counterparts.nil?
    print character.gsub(/(?=[$`\\])/, "\\\\")
  elsif counterparts.include?(" ")
    print "${#{count}:{#{character}=#{counterparts.split(" ").join("|")}\\}}"
    count += 1
  else
    print counterparts
  end
end
print "${0:}" if count &gt; 1</string>
	<key>input</key>
	<string>selection</string>
	<key>keyEquivalent</key>
	<string>^~@c</string>
	<key>name</key>
	<string>Simplified &gt; Traditional</string>
	<key>output</key>
	<string>insertAsSnippet</string>
	<key>uuid</key>
	<string>3E097917-F8EA-4357-B830-3E04B3A70DC8</string>
</dict>
</plist>
